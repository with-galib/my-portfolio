PORT=3000
# Token for GET /api/messages (leave empty to disable the endpoint)
ADMIN_TOKEN=change-me
# Comma-separated frontend origins allowed to call the API (e.g. GitHub Pages)
ALLOWED_ORIGINS=https://with-galib.github.io
# Set to 1 when running behind a proxy/load balancer so rate limits see real IPs
TRUST_PROXY=1
